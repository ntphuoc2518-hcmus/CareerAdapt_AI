# CareerAdapt AI - sao chép thành .env rồi sửa nếu cần. Không đưa .env lên Git.
CAREERADAPT_ENV=development
# Chỉ đặt production khi chạy qua HTTPS.
CAREERADAPT_DEBUG=False
# Cổng và địa chỉ của máy chủ khi chạy run.py / start.bat. Đổi PORT nếu cổng 8000 đã bị dùng.
PORT=8000
HOST=127.0.0.1
# false: không tự mở trình duyệt khi khởi động (ví dụ khi chạy trên máy chủ).
CAREERADAPT_OPEN_BROWSER=true
# Địa chỉ công khai dùng trong email đặt lại mật khẩu (bắt buộc khi production), ví dụ https://careeradapt.example.vn
CAREERADAPT_PUBLIC_URL=
# Tên miền được phép (production), cách nhau bằng dấu phẩy. Để trống = không kiểm tra Host.
CAREERADAPT_ALLOWED_HOSTS=
# Địa chỉ reverse proxy được phép gửi X-Forwarded-For (giới hạn đăng nhập theo IP thật của người dùng).
CAREERADAPT_TRUSTED_PROXIES=127.0.0.1

# Dịch vụ AI (không bắt buộc). mock = chỉ dùng bộ kiểm tra xác định và tra cứu, không giả lập AI.
# Giá trị hỗ trợ: mock, gemini, openai (openai chỉ cho nhận xét bài chấm, chưa có Trợ lý).
LLM_PROVIDER=mock
LLM_API_KEY=
# Để trống thì Gemini dùng gemini-3.5-flash-lite.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20.0
LLM_MAX_RETRIES=2

# Trợ lý CareerAdapt AI. Để trống AI_EMBEDDING_MODEL thì Gemini dùng gemini-embedding-2.
AI_EMBEDDING_MODEL=
AI_CHAT_PER_MINUTE=8
AI_DAILY_TOKENS_PER_USER=60000
AI_DAILY_TOKENS_TOTAL=1000000
AI_MAX_TOOL_ROUNDS=4
AI_REQUEST_DEADLINE_SECONDS=45
AI_CONTEXT_MESSAGES=12

# Chấm bài chạy nền: số luồng chấm cùng lúc (giới hạn số sandbox chạy song song).
CAREERADAPT_GRADING_WORKERS=2
# true = chấm ngay trong yêu cầu nộp bài như trước 5.19 (chỉ dùng khi gỡ lỗi).
CAREERADAPT_SYNC_GRADING=false

# Tự kiểm tra link học liệu đến hạn (cần Internet).
CAREERADAPT_AUTO_LINK_CHECK=true

# Chỉ dùng khi trình diễn: nút "Giả lập đến hạn" và mô phỏng lỗi AI. Luôn tắt ở production.
CAREERADAPT_ENABLE_DEMO_TOOLS=false
CAREERADAPT_ENABLE_FAULT_INJECTION=false

# Chỉ dùng trong kiểm thử: mở lại POST /submissions cho học viên, bỏ qua luật một lần.
CAREERADAPT_LEGACY_ASSESSMENT_API=false
