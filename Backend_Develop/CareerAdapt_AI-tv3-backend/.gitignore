# Bí mật: KHÔNG BAO GIỜ đưa lên git
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc

# Dữ liệu người dùng (giữ lại đúng 1 file .gitkeep để thư mục tồn tại)
secure_storage/*
!secure_storage/.gitkeep

# Bản sao lưu và dữ liệu xuất ra chứa thông tin cá nhân
backups/
exports/
*.dump

# File sinh ra
project_bundle.txt
*.log